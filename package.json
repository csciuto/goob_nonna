{
  "name": "goob-nonna",
  "version": "1.0.0",
  "description": "Web-based Moog Grandmother synthesizer clone",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "serve": "python3 -m http.server 8080",
    "screenshot": "UPDATE_PREVIEW=1 playwright test tests/e2e/smoke.spec.js --project=desktop",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "serve": "^14.2.6",
    "vitest": "^1.6.0",
    "@axe-core/playwright": "4.10.2"
  }
}
